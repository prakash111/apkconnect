<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/bg_card">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Provision User Account"
        android:textColor="#F8FAFC"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Create a new developer or client account with decompilation quotas."
        android:textColor="#94A3B8"
        android:textSize="12sp"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/editNewUserEmail"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_input_field"
        android:hint="User Email Address"
        android:inputType="textEmailAddress"
        android:textColor="#F8FAFC"
        android:textColorHint="#64748B"
        android:textSize="13sp"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="10dp" />

    <EditText
        android:id="@+id/editNewUserUsername"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_input_field"
        android:hint="Username"
        android:textColor="#F8FAFC"
        android:textColorHint="#64748B"
        android:textSize="13sp"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="10dp" />

    <EditText
        android:id="@+id/editNewUserPassword"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_input_field"
        android:hint="Account Password"
        android:inputType="textPassword"
        android:textColor="#F8FAFC"
        android:textColorHint="#64748B"
        android:textSize="13sp"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnSubmitCreateUser"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:text="Create Account"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="@drawable/bg_btn_danger"
        android:textColor="#FFFFFF" />
</LinearLayout>
