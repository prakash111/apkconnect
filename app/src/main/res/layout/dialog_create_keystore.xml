<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp"
    android:background="@color/bg_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Generate RSA 2048-bit Keystore"
            android:textColor="#F8FAFC"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Creates an isolated production-ready JKS signing keystore with keytool."
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="14dp" />

        <EditText
            android:id="@+id/editKeystoreAlias"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_input_field"
            android:hint="Key Alias (e.g. release_key)"
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B"
            android:textSize="13sp"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/editKeystorePassword"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_input_field"
            android:hint="Keystore Password (min 6 chars)"
            android:inputType="textPassword"
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B"
            android:textSize="13sp"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/editKeystoreKeyPassword"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_input_field"
            android:hint="Key Password (optional, defaults to keystore pass)"
            android:inputType="textPassword"
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B"
            android:textSize="13sp"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/editKeystoreValidity"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_input_field"
            android:hint="Validity in Days (e.g. 10000)"
            android:text="10000"
            android:inputType="number"
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B"
            android:textSize="13sp"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/editKeystoreCommonName"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_input_field"
            android:hint="Developer Name / CN (e.g. Android Developer)"
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B"
            android:textSize="13sp"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="14dp" />

        <Button
            android:id="@+id/btnSubmitCreateKeystore"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="Generate Production Keystore"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_primary"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</ScrollView>
