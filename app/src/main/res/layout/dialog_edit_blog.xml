<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp"
    android:background="@color/bg_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtBlogDialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SEO Blog Post Manager"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Publish articles and tutorials to /blog.php connected to the MySQL database."
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="14dp" />

        <EditText
            android:id="@+id/editBlogTitle"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/bg_input_field"
            android:hint="Article Title"
            android:textSize="13sp"
            android:paddingHorizontal="10dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/editBlogCategory"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_field"
                android:hint="Category (e.g. Tutorials)"
                android:textSize="12sp"
                android:paddingHorizontal="10dp"
                android:layout_marginEnd="6dp" />

            <EditText
                android:id="@+id/editBlogReadTime"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_field"
                android:hint="Read Time (e.g. 5 min read)"
                android:textSize="12sp"
                android:paddingHorizontal="10dp" />
        </LinearLayout>

        <EditText
            android:id="@+id/editBlogTags"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/bg_input_field"
            android:hint="Tags (e.g. APK, Android, Decompile)"
            android:textSize="12sp"
            android:paddingHorizontal="10dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/editBlogExcerpt"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/bg_input_field"
            android:hint="Short Excerpt..."
            android:textSize="12sp"
            android:gravity="top|start"
            android:padding="10dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/editBlogContent"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:background="@drawable/bg_input_field"
            android:hint="Article Content (HTML / Markdown)..."
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:gravity="top|start"
            android:padding="10dp"
            android:layout_marginBottom="14dp" />

        <Button
            android:id="@+id/btnSubmitBlog"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Publish Article"
            android:backgroundTint="@color/primary"
            android:textColor="#FFFFFF"
            app:cornerRadius="10dp" />
    </LinearLayout>
</ScrollView>
